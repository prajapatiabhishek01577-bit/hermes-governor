diff --git a/agent/plugin_completion_policy.py b/agent/plugin_completion_policy.py
new file mode 100644
index 0000000000000000000000000000000000000000..e8438c5d1c6b85e340e82c4fec27f586344c7abc
--- /dev/null
+++ b/agent/plugin_completion_policy.py
@@ -0,0 +1,52 @@
+"""Opt-in native plugin completion policy; no policy when hooks are absent.
+
+Pre-LLM hooks may request buffered delivery and non-coding verification.
+Completion gates run after cosmetic transforms and fail closed if a policy
+was requested but its gate disappears. No system prompt/toolset is mutated.
+"""
+from __future__ import annotations
+
+
+def available_policy_tools(agent):
+    """Include session-scoped deferred capabilities without changing model tools."""
+    visible = list(getattr(agent, "tools", None) or [])
+    names = {s.get("function", s).get("name") for s in visible}
+    if "tool_call" in names:
+        from agent.tool_executor import _tool_search_scoped_names
+        from tools.registry import registry
+        for name in sorted(_tool_search_scoped_names(agent) - names):
+            entry = registry.get_entry(name)
+            if entry is not None:
+                visible.append({"type": "function", "function": entry.schema})
+    return visible
+
+
+def set_turn_policy(agent, results):
+    agent._plugin_buffer_output = False
+    agent._plugin_verify_on_stop = False
+    agent._plugin_completion_required = False
+    for result in results:
+        policy = result.get("completion_policy") if isinstance(result, dict) else None
+        if not isinstance(policy, dict):
+            continue
+        agent._plugin_buffer_output |= policy.get("buffer_output") is True
+        agent._plugin_verify_on_stop |= policy.get("verify_on_stop") is True
+        agent._plugin_completion_required |= policy.get("required") is True
+
+
+def completion_decision(agent, text):
+    if getattr(agent, "_plugin_completion_required", False) is not True:
+        return None
+    from hermes_cli.lifecycle import invoke_hook
+    results = invoke_hook("completion_gate", session_id=agent.session_id or "",
+                          response_text=text or "", platform=getattr(agent, "platform", "") or "")
+    valid = [r for r in results if isinstance(r, dict) and isinstance(r.get("verified"), bool)]
+    # Any veto wins, even if a different plugin approves the answer.
+    veto = next((r for r in valid if not r["verified"]), None)
+    if veto:
+        return {"verified": False, "response_text": veto.get("response_text") or
+                "BLOCKED: completion policy did not verify the objective."}
+    if valid:
+        return {"verified": True, "response_text": text}
+    return {"verified": False, "response_text":
+            "BLOCKED: required completion policy is unavailable; no verified completion."}
